@startuml
title Sequence Diagram - UC-06 - Skip Break

autonumber
actor Learner
participant "Desktop UI" as UI
participant "SessionController" as Controller
participant "SkipBreakUseCase" as UseCase
participant "FocusSessionRepository" as Repo
participant "FocusSession" as Session
participant "TransactionalOutbox" as Events
participant "Outbox Dispatcher" as Dispatcher
participant "SessionWebSocketHandler" as WS

Learner -> UI : click "Skip break"
UI -> Controller : POST /api/v1/sessions/{id}/skip-break
Controller -> UseCase : skip(command)
UseCase -> Repo : findById(sessionId)
Repo --> UseCase : Optional<FocusSession>

UseCase -> Session : skipBreak(now)
activate Session
alt session waiting with a pending break
  Session -> Session : currentInterval().skipPending(now)
else session paused during a break
  Session -> Session : currentInterval().skipPaused(now)
  note right of Session : Elapsed break duration is retained.
end
Session -> Session : create and start work interval
Session --> UseCase : updated session
deactivate Session
UseCase -> Repo : save(session)
Repo --> UseCase : saved
UseCase -> Events : appendToOutbox(BreakSkipped)
UseCase -> Events : appendToOutbox(IntervalStarted)
UseCase --> Controller : SessionDto
Controller --> UI : 200 OK
... transaction commits ...
Dispatcher -> WS : broadcast committed break.skipped and interval.started events
WS --> UI : session snapshots with work interval running

note over Session
  Skipped breaks do not count as focus work.
  A pending break has zero elapsed duration; a paused break
  retains the elapsed duration recorded before it was paused.
end note

@enduml
